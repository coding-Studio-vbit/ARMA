# Server Port (Render/Railway injects PORT automatically)
PORT=5001

# MongoDB Connection String (MongoDB Atlas M0 Free Cluster)
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/arma?retryWrites=true&w=majority
MONGO_CONNECTION_STRING=mongodb://localhost:27017/arma

# Environment Mode
NODE_ENV=production

# Security & Auth
JWT_SECRET_KEY=your_jwt_secret_key_here
SALTROUNDS=10

# API Response Status Codes
SUCCESS_CODE=1
FAILURE_CODE=0

# Cloudinary Storage (Free 25 GB tier: https://cloudinary.com)
# When provided, all uploads (PDFs, docx, club logos) stream directly to Cloudinary.
# When omitted, uploads fall back to local disk storage.
CLOUDINARY_CLOUD_NAME=wua5jevh
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
# Alternatively:
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@wua5jevh

# SSL Configuration
# Set to false for cloud hosts (Render, Railway, Fly.io) where SSL is handled at edge.
ENABLE_LOCAL_SSL=false
